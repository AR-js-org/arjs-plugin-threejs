# package.json `files` decides what is published: dist/ and types/ without
# source maps, plus the README, LICENSE and package.json npm always adds. A
# new file at the root stays out because `files` does not list it, not
# because of this list. Check the result with `npm pack --dry-run`.

# OS / editor
.DS_Store
.vscode/
.idea/

# node / build
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# source & dev
src/
dev/
examples/
tests/
test/
coverage/
.nyc_output/

*.log
dist/**/*.map
*.map

# configs (opzionale)
.eslintrc*
.prettierrc*
.editorconfig

# docs kept out of the package (#7)
CHANGELOG.md

# environment
.env
.env.local
.env.*.local

# git / github
.git/
.gitignore
.github/

# maps (opzionale)
*.map